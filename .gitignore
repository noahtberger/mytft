# Machine-specific, rebuilt with `python -m venv .venv` + pip install requests
.venv/
__pycache__/
.DS_Store

# Today's Riot API key, one line. Dev keys die every 24h; this file must
# never be committed - a key in git history outlives its 24 hours.
.riot_key

# Packaged build of the retired Overwolf logger - the source folder is enough
*.zip

# Other players' games, downloaded by serve.py and scout.py. matches/ is your
# own history and gets committed because Riot deletes old games; the pool is
# strangers' games, re-downloadable, and would bloat the repo for nothing.
# Readers take the union of the two, so the pool includes your games already.
pool/

# Generated by build_site.py from matches/ - rebuildable, so not committed.
site/

# The recently-looked-up list serve.py keeps for the front page. Local
# convenience, not data - and it holds other people's names.
recent.json

# PyInstaller output - rebuildable from mytft.spec
build/
dist/

# Generated icon intermediates; MyTFT.icns is committed, the rest rebuilds
icon/MyTFT.iconset/
icon/icon-1024.png
icon/icon.html

# The LAN toggle is a local choice, not a project setting
lan-access

# Flat copy of every board, rebuilt from matches/ + pool/ by index.py.
# Derived and disposable - `python index.py --rebuild` regenerates it.
boards.db
